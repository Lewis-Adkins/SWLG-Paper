@article{LaNeve2026,
author = {LaNeve, C. M. and Oughton, E. J. and Rivera, N. and Weigel, R. S. and Thomas, D. and Gaunt, C. T.},
title = {Space Weather Mitigation Decisions by Critical Infrastructure Operators During Solar Cycle 25},
journal = {Space Weather},
volume = {24},
number = {9},
pages = {e2026SW005072},
keywords = {space weather mitigation, critical infrastructure, operational decision making, geomagnetic storms, solar cycle 25},
doi = {https://doi.org/10.1029/2026SW005072},
url = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1029/2026SW005072},
eprint = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/2026SW005072},
note = {e2026SW005072 2026SW005072},
abstract = {Abstract The “Gannon Storm” in May 2024 was the largest space weather event experienced in 20 years, generating auroras at latitudes as low as 35°, visible in Florida and Mexico. Such events pose significant operational challenges for critical infrastructure operators, particularly those managing electricity transmission networks, satellite constellations, and aviation systems. Substantial progress has been made in understanding space weather and the potential exposure of infrastructure assets to severe events. Yet, we have seen very little evaluation of the types of current mitigation strategies used to reduce our shared vulnerability to this activity, motivating this study. First, we filled an important literature gap by undertaking a review of the range of space weather mitigation strategies available. Then, we contacted 313 critical infrastructure operators (50 power, 227 satellite, 36 aviation) for participation in an anonymous online survey and/or interview receiving 55 unique responses (18\% response rate). We developed a time-sensitive data set, through conducting qualitative interviews with 33 operators, capturing operational decisions made during peak solar activity. The results identified 91 potential mitigation decisions across the three sectors and found that 74\% of these were undertaken. This is one of the first substantial studies of space weather mitigation activities and moves beyond the traditional focus on physical and economic impacts.},
year = {2026}
}

